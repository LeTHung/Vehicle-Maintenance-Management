<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DocumentAlertController"
      stylesheets="@../css/pages/document-alert.css"
      spacing="18"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Cảnh báo giấy tờ xe" styleClass="page-title"/>
        <Label text="Hiển thị dữ liệu từ view vw_due_vehicle_documents: giấy tờ đã hết hạn hoặc sắp hết hạn." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12" styleClass="toolbar">
        <ComboBox fx:id="cbAlertType" promptText="Loại cảnh báo" prefWidth="220" styleClass="input-field"/>
        <TextField fx:id="txtSearch" promptText="Tìm theo biển số xe, số giấy tờ..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <Button text="Tìm kiếm" onAction="#handleSearchAlert" styleClass="secondary-button"/>
        <Button text="Làm mới" onAction="#handleRefreshAlert" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="summary-card alert-summary-danger" HBox.hgrow="ALWAYS">
            <Label text="Đã hết hạn" styleClass="summary-title"/>
            <Label fx:id="lblExpiredCount" text="0" styleClass="summary-number danger-text"/>
        </VBox>

        <VBox styleClass="summary-card alert-summary-warning" HBox.hgrow="ALWAYS">
            <Label text="Sắp hết hạn" styleClass="summary-title"/>
            <Label fx:id="lblWarningCount" text="0" styleClass="summary-number warning-text"/>
        </VBox>

        <VBox styleClass="summary-card alert-summary-primary" HBox.hgrow="ALWAYS">
            <Label text="Tổng cảnh báo" styleClass="summary-title"/>
            <Label fx:id="lblTotalAlertCount" text="0" styleClass="summary-number primary-text"/>
        </VBox>
    </HBox>

    <TableView fx:id="tblAlert" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colDocumentId" text="Mã giấy tờ" prefWidth="100"/>
            <TableColumn fx:id="colVehicleId" text="Mã xe" prefWidth="80"/>
            <TableColumn fx:id="colLicensePlate" text="Biển số" prefWidth="130"/>
            <TableColumn fx:id="colVehicleType" text="Loại xe" prefWidth="120"/>
            <TableColumn fx:id="colDocumentTypeName" text="Loại giấy tờ" prefWidth="160"/>
            <TableColumn fx:id="colDocumentNumber" text="Số giấy tờ" prefWidth="130"/>
            <TableColumn fx:id="colIssuerName" text="Đơn vị cấp" prefWidth="180"/>
            <TableColumn fx:id="colExpiryDate" text="Ngày hết hạn" prefWidth="140"/>
            <TableColumn fx:id="colDaysToExpiry" text="Số ngày còn lại" prefWidth="150"/>
            <TableColumn fx:id="colDueStatus" text="Trạng thái cảnh báo" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>
