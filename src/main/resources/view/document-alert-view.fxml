<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DocumentAlertController"
      stylesheets="@../css/pages/document-alert.css"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Cảnh báo giấy tờ xe" styleClass="page-title"/>
        <Label text="Hiển thị giấy tờ đã hết hạn hoặc sắp hết hạn trong 15 ngày." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12" styleClass="toolbar">
        <ComboBox fx:id="cbAlertType" promptText="Loại cảnh báo" prefWidth="220" styleClass="input-field"/>
        <TextField fx:id="txtSearch" promptText="Tìm theo biển số xe..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <Button text="Tìm kiếm" onAction="#handleSearchAlert" styleClass="secondary-button"/>
        <Button text="Làm mới" onAction="#handleRefreshAlert" styleClass="primary-button"/>
    </HBox>

    <HBox spacing="16">
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Đã hết hạn" styleClass="summary-title"/>
            <Label fx:id="lblExpiredCount" text="0" styleClass="summary-number danger-text"/>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Sắp hết hạn trong 15 ngày" styleClass="summary-title"/>
            <Label fx:id="lblWarningCount" text="0" styleClass="summary-number warning-text"/>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Tổng cảnh báo" styleClass="summary-title"/>
            <Label fx:id="lblTotalAlertCount" text="0" styleClass="summary-number primary-text"/>
        </VBox>
    </HBox>

    <TableView fx:id="tblAlert" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colVehiclePlate" text="Biển số xe" prefWidth="140"/>
            <TableColumn fx:id="colDocumentType" text="Loại giấy tờ" prefWidth="170"/>
            <TableColumn fx:id="colIssueDate" text="Ngày cấp" prefWidth="130"/>
            <TableColumn fx:id="colExpiryDate" text="Ngày hết hạn" prefWidth="140"/>
            <TableColumn fx:id="colDaysLeft" text="Số ngày còn lại" prefWidth="150"/>
            <TableColumn fx:id="colAlertStatus" text="Trạng thái" prefWidth="180"/>
            <TableColumn fx:id="colNote" text="Ghi chú" prefWidth="260"/>
        </columns>
    </TableView>
</VBox>
