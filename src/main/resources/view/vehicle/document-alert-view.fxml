<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.vehicle.DocumentAlertController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">
        <VBox styleClass="page-header">
            <Label text="Cảnh báo giấy tờ" styleClass="page-title"/>
            <Label text="Hiển thị giấy tờ đã hết hạn hoặc sắp hết hạn dựa trên view vw_due_vehicle_documents." styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="18">
            <VBox styleClass="summary-danger" HBox.hgrow="ALWAYS">
                <Label text="Đã hết hạn" styleClass="metric-label"/>
                <Label fx:id="lblExpiredCount" text="0" styleClass="metric-value-danger"/>
                <Label text="Quá hạn" styleClass="metric-trend-danger"/>
            </VBox>
            <VBox styleClass="summary-warning" HBox.hgrow="ALWAYS">
                <Label text="Sắp hết hạn" styleClass="metric-label"/>
                <Label fx:id="lblWarningCount" text="0" styleClass="metric-value-warning"/>
                <Label text="Sắp hết hạn" styleClass="metric-trend-warning"/>
            </VBox>
            <VBox styleClass="summary-primary" HBox.hgrow="ALWAYS">
                <Label text="Tổng cảnh báo" styleClass="metric-label"/>
                <Label fx:id="lblTotalAlertCount" text="0" styleClass="metric-value"/>
                <Label text="Cần xử lý" styleClass="metric-trend-primary"/>
            </VBox>
        </HBox>

        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbAlertType" promptText="Loại cảnh báo" prefWidth="190"/>
            <TextField fx:id="txtSearch"
                       promptText="Tìm theo biển số, số giấy tờ, đơn vị cấp..."
                       HBox.hgrow="ALWAYS"
                       styleClass="search-field"/>
            <Button text="Tìm kiếm" onAction="#handleSearchAlert" styleClass="btn-ghost"/>
            <Button text="Làm mới" onAction="#handleRefreshAlert" styleClass="btn-primary"/>
        </HBox>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Danh sách cảnh báo" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblAlert" prefHeight="410" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colDocumentId" text="Mã giấy tờ" prefWidth="100"/>
                    <TableColumn fx:id="colVehicleId" text="Mã xe" prefWidth="90"/>
                    <TableColumn fx:id="colLicensePlate" text="Biển số" prefWidth="120"/>
                    <TableColumn fx:id="colVehicleType" text="Loại xe" prefWidth="120"/>
                    <TableColumn fx:id="colDocumentTypeName" text="Loại giấy tờ" prefWidth="150"/>
                    <TableColumn fx:id="colDocumentNumber" text="Số giấy tờ" prefWidth="130"/>
                    <TableColumn fx:id="colIssuerName" text="Đơn vị cấp" prefWidth="220"/>
                    <TableColumn fx:id="colExpiryDate" text="Ngày hết hạn" prefWidth="130"/>
                    <TableColumn fx:id="colDaysToExpiry" text="Số ngày" prefWidth="90"/>
                    <TableColumn fx:id="colDueStatus" text="Trạng thái" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
