<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.maintenance.MaintenanceRecordController" fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">
        <VBox styleClass="page-header">
            <Label text="Cập nhật bảo dưỡng" styleClass="page-title"/>
            <Label text="Nhấn đúp vào một phiếu trong bảng để xem chi tiết, hoặc tạo phiếu bảo dưỡng mới." styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbFilterVehicle" promptText="Lọc theo xe..." prefWidth="260"/>
            <Button text="Làm mới" onAction="#handleRefresh" styleClass="btn-soft"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="+ Tạo phiếu mới" onAction="#handleNewRecord" styleClass="btn-primary"/>
        </HBox>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <VBox spacing="3">
                    <Label text="Danh sách phiếu bảo dưỡng" styleClass="section-title"/>
                    <Label text="Nhấn đúp vào một dòng để mở cửa sổ phiếu và danh sách hạng mục." styleClass="table-note"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblRecord" prefHeight="380" fixedCellSize="44" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colRecordId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colRecordLicensePlate" text="Biển số" prefWidth="125"/>
                    <TableColumn fx:id="colRecordType" text="Loại phiếu" prefWidth="135"/>
                    <TableColumn fx:id="colRecordTitle" text="Tiêu đề" prefWidth="240"/>
                    <TableColumn fx:id="colRecordServiceDate" text="Ngày thực hiện" prefWidth="140"/>
                    <TableColumn fx:id="colRecordOdometer" text="ODO (km)" prefWidth="105"/>
                    <TableColumn fx:id="colRecordTechnician" text="Kỹ thuật viên" prefWidth="180"/>
                    <TableColumn fx:id="colRecordTotalCost" text="Chi phí (VNĐ)" prefWidth="145"/>
                    <TableColumn fx:id="colRecordStatus" text="Trạng thái" prefWidth="135"/>
                </columns>
            </TableView>
        </VBox>

        <VBox fx:id="recordDetailPanel" spacing="12" visible="false" managed="false">
            <VBox spacing="8" styleClass="form-panel, detail-panel, record-summary-panel">
                <VBox spacing="0">
                    <Label fx:id="lblRecordDetailTitle" text="Thông tin phiếu bảo dưỡng" styleClass="section-title"/>
                </VBox>
                <GridPane hgap="14" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.34"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Xe" styleClass="form-label, detail-field-label"/>
                            <ComboBox fx:id="cbVehicle" promptText="Chọn xe..." maxWidth="Infinity"/>
                            <Label fx:id="lblVehicleCurrentOdometer" styleClass="form-hint" managed="false" visible="false"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Loại phiếu" styleClass="form-label, detail-field-label"/>
                        <ComboBox fx:id="cbRecordType" promptText="Chọn loại..." maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="0" GridPane.columnIndex="2">
                        <Label text="Trạng thái" styleClass="form-label, detail-field-label"/>
                        <ComboBox fx:id="cbRecordStatus" promptText="Chọn trạng thái..." maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="1" GridPane.columnIndex="0">
                        <Label text="Kế hoạch" styleClass="form-label, detail-field-label"/>
                        <ComboBox fx:id="cbPlan" promptText="Không bắt buộc..." maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2">
                        <Label text="Tiêu đề" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtTitle" promptText="Bảo dưỡng định kỳ 50.000 km" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="2" GridPane.columnIndex="0">
                        <Label text="Ngày thực hiện" styleClass="form-label, detail-field-label"/>
                        <DatePicker fx:id="dpServiceDate" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="2" GridPane.columnIndex="1">
                        <Label text="ODO (km)" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtOdometer" promptText="Chọn xe để xem ODO tối thiểu" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="2" GridPane.columnIndex="2">
                        <Label text="Chi phí (VNĐ)" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtTotalCost" promptText="Ví dụ: 1500000" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="3" GridPane.columnIndex="0">
                        <Label text="Nhà cung cấp" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtServiceProvider" promptText="Garage / Trung tâm bảo dưỡng" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2">
                        <Label text="Nội dung" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtWorkSummary" promptText="Mô tả công việc đã thực hiện..." HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="detail-field" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="3">
                        <Label text="Ghi chú" styleClass="form-label, detail-field-label"/>
                        <TextField fx:id="txtNotes" HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="3">
                        <Button text="Lưu phiếu" onAction="#handleSave" styleClass="btn-primary"/>
                        <Button text="Cập nhật" onAction="#handleUpdate" styleClass="btn-soft"/>
                    </HBox>
                </GridPane>
            </VBox>

            <VBox styleClass="form-panel, detail-panel, record-items-panel" spacing="12">
                <HBox styleClass="table-title-row, compact-title-row">
                    <Label text="Hạng mục / Phụ tùng" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Xóa hết" onAction="#handleClearItems" styleClass="btn-ghost"/>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ComboBox fx:id="cbItemType" prefWidth="128" minWidth="120"/>
                    <TextField fx:id="txtItemDesc" promptText="Mô tả hạng mục / phụ tùng..." HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="txtItemQty" promptText="Số lượng" prefWidth="90"/>
                    <ComboBox fx:id="cbItemUnit" promptText="Đơn vị" prefWidth="118" minWidth="110"/>
                    <TextField fx:id="txtItemUnitCost" promptText="Đơn giá" prefWidth="130"/>
                    <Label fx:id="lblItemLineTotal" text="= 0 VNĐ" prefWidth="130" styleClass="form-label"/>
                    <Button text="+ Thêm" onAction="#handleAddItem" styleClass="btn-primary"/>
                </HBox>
                <TableView fx:id="tblItems" prefHeight="320" minHeight="280" fixedCellSize="44" styleClass="data-table, embedded-table">
                    <columns>
                        <TableColumn fx:id="colItemType" text="Loại" prefWidth="120"/>
                        <TableColumn fx:id="colItemDesc" text="Mô tả" prefWidth="320"/>
                        <TableColumn fx:id="colItemQty" text="Số lượng" prefWidth="90"/>
                        <TableColumn fx:id="colItemUnit" text="Đơn vị" prefWidth="90"/>
                        <TableColumn fx:id="colItemUnitCost" text="Đơn giá" prefWidth="130"/>
                        <TableColumn fx:id="colItemLineTotal" text="Thành tiền" prefWidth="135"/>
                        <TableColumn fx:id="colItemRemove" text="Thao tác" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
