<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.maintenance.MaintenanceRecordController" fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">
        <VBox styleClass="page-header">
            <Label text="Cập nhật bảo dưỡng" styleClass="page-title"/>
            <Label text="Tạo và quản lý phiếu bảo dưỡng/sửa chữa, nhập nội dung, phụ tùng, chi phí và ODO." styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbFilterVehicle" promptText="Lọc theo xe..." prefWidth="220"/>
            <Button text="Làm mới" onAction="#handleRefresh" styleClass="btn-soft"/>
            <Button text="+ Tạo phiếu mới" onAction="#handleNewRecord" styleClass="btn-primary"/>
        </HBox>

        <GridPane hgap="16" vgap="14" styleClass="form-panel">
            <columnConstraints>
                <ColumnConstraints percentWidth="14"/><ColumnConstraints percentWidth="19"/>
                <ColumnConstraints percentWidth="14"/><ColumnConstraints percentWidth="19"/>
                <ColumnConstraints percentWidth="14"/><ColumnConstraints percentWidth="20"/>
            </columnConstraints>

            <Label text="Xe" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
            <ComboBox fx:id="cbVehicle" promptText="Chọn xe..." maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Loại phiếu" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
            <ComboBox fx:id="cbRecordType" promptText="Chọn loại..." maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <Label text="Trạng thái" GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="form-label"/>
            <ComboBox fx:id="cbRecordStatus" promptText="Chọn trạng thái..." maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="5"/>

            <Label text="Tiêu đề" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
            <TextField fx:id="txtTitle" promptText="Bảo dưỡng định kỳ 50.000 km" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="5"/>

            <Label text="Ngày thực hiện" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
            <DatePicker fx:id="dpServiceDate" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="ODO khi bảo dưỡng (km)" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
            <TextField fx:id="txtOdometer" promptText="Ví dụ: 50000" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <Label text="Tổng chi phí (VNĐ)" GridPane.rowIndex="2" GridPane.columnIndex="4" styleClass="form-label"/>
            <TextField fx:id="txtTotalCost" promptText="Ví dụ: 1500000" GridPane.rowIndex="2" GridPane.columnIndex="5"/>

            <Label text="Nhà cung cấp" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
            <TextField fx:id="txtServiceProvider" promptText="Garage / Trung tâm bảo dưỡng" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
            <Label text="Nội dung công việc" GridPane.rowIndex="3" GridPane.columnIndex="3" styleClass="form-label"/>
            <TextField fx:id="txtWorkSummary" promptText="Mô tả công việc đã thực hiện..." GridPane.rowIndex="3" GridPane.columnIndex="4" GridPane.columnSpan="2"/>

            <Label text="Ghi chú" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
            <TextField fx:id="txtNotes" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="5"/>

            <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="6">
                <Button text="Lưu phiếu" onAction="#handleSave" styleClass="btn-primary"/>
                <Button text="Cập nhật" onAction="#handleUpdate" styleClass="btn-soft"/>
                <Button text="Xóa trắng" onAction="#handleClear" styleClass="btn-ghost"/>
            </HBox>
        </GridPane>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Danh sách phiếu bảo dưỡng" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblRecord" prefHeight="360" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colRecordId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colRecordLicensePlate" text="Biển số" prefWidth="120"/>
                    <TableColumn fx:id="colRecordType" text="Loại" prefWidth="120"/>
                    <TableColumn fx:id="colRecordTitle" text="Tiêu đề" prefWidth="200"/>
                    <TableColumn fx:id="colRecordServiceDate" text="Ngày thực hiện" prefWidth="130"/>
                    <TableColumn fx:id="colRecordOdometer" text="ODO (km)" prefWidth="100"/>
                    <TableColumn fx:id="colRecordTotalCost" text="Chi phí (VNĐ)" prefWidth="130"/>
                    <TableColumn fx:id="colRecordStatus" text="Trạng thái" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
