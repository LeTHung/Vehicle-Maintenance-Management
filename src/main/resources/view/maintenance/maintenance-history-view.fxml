<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.maintenance.MaintenanceHistoryController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">

        <VBox styleClass="page-header">
            <Label text="Lịch sử bảo dưỡng" styleClass="page-title"/>
            <Label text="Tra cứu toàn bộ lịch sử bảo dưỡng và sửa chữa theo từng phương tiện." styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbVehicle" promptText="Chọn xe để xem lịch sử..." prefWidth="260"/>
            <Label fx:id="lblRecordCount" text="Chưa chọn xe" styleClass="metric-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Làm mới" onAction="#handleRefresh" styleClass="btn-soft"/>
        </HBox>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Danh sách phiếu bảo dưỡng" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblHistory" prefHeight="280" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colHistoryId"     text="ID"             prefWidth="60"/>
                    <TableColumn fx:id="colHistoryType"   text="Loại phiếu"     prefWidth="110"/>
                    <TableColumn fx:id="colHistoryTitle"  text="Tiêu đề"        prefWidth="220"/>
                    <TableColumn fx:id="colHistoryDate"   text="Ngày thực hiện" prefWidth="140"/>
                    <TableColumn fx:id="colHistoryOdo"    text="ODO"            prefWidth="110"/>
                    <TableColumn fx:id="colHistoryCost"   text="Chi phí"        prefWidth="150"/>
                    <TableColumn fx:id="colHistoryStatus" text="Trạng thái"     prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Hạng mục / Phụ tùng (chọn phiếu bên trên để xem)" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblItems" prefHeight="200" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colItemType"      text="Loại"       prefWidth="80"/>
                    <TableColumn fx:id="colItemDesc"      text="Mô tả"      prefWidth="280"/>
                    <TableColumn fx:id="colItemQty"       text="SL"         prefWidth="70"/>
                    <TableColumn fx:id="colItemUnit"      text="Đơn vị"     prefWidth="80"/>
                    <TableColumn fx:id="colItemUnitCost"  text="Đơn giá"    prefWidth="140"/>
                    <TableColumn fx:id="colItemLineTotal" text="Thành tiền" prefWidth="140"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
