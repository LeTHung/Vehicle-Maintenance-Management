<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.maintenance.MaintenanceAlertController"
            fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">

        <VBox styleClass="page-header">
            <Label text="Cảnh báo bảo dưỡng" styleClass="page-title"/>
            <Label text="Danh sách xe đã quá hạn hoặc sắp đến hạn bảo dưỡng theo ngày / số km." styleClass="page-subtitle"/>
        </VBox>

        <!-- Thống kê nhanh -->
        <HBox spacing="16">
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="Quá hạn" styleClass="summary-label"/>
                <Label fx:id="lblOverdueCount" text="0" styleClass="summary-value-danger"/>
            </VBox>
            <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
                <Label text="Sắp đến hạn" styleClass="summary-label"/>
                <Label fx:id="lblComingDueCount" text="0" styleClass="summary-value-warning"/>
            </VBox>
        </HBox>

        <!-- Toolbar -->
        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbFilterStatus" promptText="Lọc trạng thái..." prefWidth="200"/>
            <Button text="Làm mới" onAction="#handleRefresh" styleClass="btn-soft"/>
        </HBox>

        <!-- Bảng cảnh báo -->
        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Xe cần bảo dưỡng" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="tblAlert" prefHeight="420" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colAlertPlanId"         text="ID"              prefWidth="60"/>
                    <TableColumn fx:id="colAlertLicensePlate"   text="Biển số"         prefWidth="120"/>
                    <TableColumn fx:id="colAlertVehicleType"    text="Loại xe"         prefWidth="120"/>
                    <TableColumn fx:id="colAlertMaintenanceName" text="Loại bảo dưỡng" prefWidth="170"/>
                    <TableColumn fx:id="colAlertCurrentOdo"     text="ODO hiện tại"    prefWidth="120"/>
                    <TableColumn fx:id="colAlertNextDueDate"    text="Ngày đến hạn"    prefWidth="130"/>
                    <TableColumn fx:id="colAlertNextDueOdo"     text="ODO đến hạn"     prefWidth="120"/>
                    <TableColumn fx:id="colAlertStatus"         text="Trạng thái"      prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

    </VBox>
</ScrollPane>
