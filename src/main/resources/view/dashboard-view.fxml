<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.DashboardController"
      stylesheets="@../css/pages/dashboard.css"
      spacing="18"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Dashboard" styleClass="page-title"/>
        <Label text="Tổng quan nhanh về phương tiện, giấy tờ và cảnh báo." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Tổng phương tiện" styleClass="summary-title"/>
            <Label fx:id="lblTotalVehicleCount" text="0" styleClass="summary-number primary-text"/>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Giấy tờ sắp hết hạn" styleClass="summary-title"/>
            <Label fx:id="lblComingDueCount" text="0" styleClass="summary-number warning-text"/>
        </VBox>

        <VBox styleClass="summary-card" HBox.hgrow="ALWAYS">
            <Label text="Giấy tờ đã hết hạn" styleClass="summary-title"/>
            <Label fx:id="lblOverdueCount" text="0" styleClass="summary-number danger-text"/>
        </VBox>
    </HBox>
    
</VBox>
