<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.DashboardController">

    <top>
        <HBox alignment="CENTER_LEFT">
            <MenuBar fx:id="menuBar" HBox.hgrow="ALWAYS">
                <Menu text="Tài khoản"/>
                <Menu text="Phương tiện"/>
                <Menu text="Bảo dưỡng"/>
                <Menu text="Báo cáo"/>
            </MenuBar>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton" text="Đăng xuất" onAction="#onLogoutClick"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12">
            <padding>
                <javafx.geometry.Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label fx:id="welcomeLabel" text="Welcome"/>
        </VBox>
    </center>
</BorderPane>
