<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.admin.AlertSettingsController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">
        <VBox styleClass="page-header">
            <Label text="Cấu hình cảnh báo" styleClass="page-title"/>
            <Label text="Thiết lập ngưỡng cảnh báo giấy tờ và kế hoạch bảo dưỡng cho toàn hệ thống." styleClass="page-subtitle"/>
        </VBox>

        <VBox spacing="18" styleClass="form-panel">
            <HBox spacing="12">
                <VBox spacing="4">
                    <Label text="Ngưỡng cảnh báo" styleClass="section-title"/>
                    <Label text="Các giá trị này được dùng cho màn cảnh báo giấy tờ và xe cần bảo dưỡng." styleClass="item-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Làm mới" onAction="#onRefreshClick" styleClass="btn-soft"/>
                <Button text="Mặc định" onAction="#onResetDefaultsClick" styleClass="btn-ghost"/>
                <Button text="Lưu cấu hình" onAction="#onSaveClick" styleClass="btn-primary"/>
            </HBox>

            <GridPane hgap="18" vgap="14">
                <padding>
                    <Insets top="4" right="0" bottom="0" left="0"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="34"/>
                </columnConstraints>

                <VBox spacing="8" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Giấy tờ sắp hết hạn trước" styleClass="form-label"/>
                    <TextField fx:id="txtDocumentAlertDays" promptText="15" prefWidth="220"/>
                    <Label text="Đơn vị: ngày, hợp lệ 1 - 365." styleClass="micro-copy"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Bảo dưỡng sắp đến hạn trước" styleClass="form-label"/>
                    <TextField fx:id="txtMaintenanceAlertDays" promptText="7" prefWidth="220"/>
                    <Label text="Đơn vị: ngày, hợp lệ 1 - 365." styleClass="micro-copy"/>
                </VBox>

                <VBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <Label text="Bảo dưỡng sắp đến km trước" styleClass="form-label"/>
                    <TextField fx:id="txtMaintenanceAlertKm" promptText="500" prefWidth="220"/>
                    <Label text="Đơn vị: km, hợp lệ 1 - 100000." styleClass="micro-copy"/>
                </VBox>
            </GridPane>

            <HBox spacing="18">
                <CheckBox fx:id="chkActive" text="Bật cấu hình cảnh báo" selected="true"/>
                <Label text="Cập nhật lần cuối:" styleClass="item-subtitle"/>
                <Label fx:id="lblUpdatedAt" text="Chưa cập nhật" styleClass="item-title"/>
            </HBox>

            <Label fx:id="lblError" text="" styleClass="error-label"/>
            <Label fx:id="lblStatus" text="" styleClass="metric-trend-success"/>
        </VBox>

        <HBox spacing="18">
            <VBox HBox.hgrow="ALWAYS" styleClass="summary-primary">
                <Label text="Giấy tờ pháp lý" styleClass="item-title"/>
                <Label text="Khi lưu, ngưỡng ngày giấy tờ được đồng bộ sang danh mục loại giấy tờ để cảnh báo hiện tại phản ánh ngay." styleClass="item-subtitle" wrapText="true"/>
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="summary-warning">
                <Label text="Bảo dưỡng" styleClass="item-title"/>
                <Label text="View xe cần bảo dưỡng dùng trực tiếp ngưỡng ngày/km từ cấu hình hệ thống." styleClass="item-subtitle" wrapText="true"/>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
