<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.admin.AuditLogController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="24" styleClass="page">
        <VBox styleClass="page-header">
            <Label text="Nhật ký hoạt động" styleClass="page-title"/>
            <Label text="Theo dõi các thao tác trong hệ thống" styleClass="page-subtitle"/>
        </VBox>

        <HBox spacing="12" styleClass="toolbar-panel">
            <ComboBox fx:id="cbActionFilter" promptText="Hành động" prefWidth="190" onAction="#onFilterChanged"/>
            <DatePicker fx:id="dpFromDate" promptText="Từ ngày" prefWidth="150" onAction="#onFilterChanged"/>
            <DatePicker fx:id="dpToDate" promptText="Đến ngày" prefWidth="150" onAction="#onFilterChanged"/>
            <Button text="Xóa lọc" onAction="#onClearFiltersClick" styleClass="btn-ghost"/>
            <Button text="Làm mới" onAction="#onRefreshClick" styleClass="btn-soft"/>
            <Label fx:id="errorLabel" text="" styleClass="error-label"/>
        </HBox>

        <VBox styleClass="table-panel">
            <HBox styleClass="table-title-row">
                <Label text="Danh sách nhật ký hoạt động" styleClass="section-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <TableView fx:id="auditLogTable" prefHeight="520" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colAuditLogId" text="ID" prefWidth="70"/>
                    <TableColumn fx:id="colUsername" text="Người dùng" prefWidth="170"/>
                    <TableColumn fx:id="colAction" text="Hành động" prefWidth="150"/>
                    <TableColumn fx:id="colEntity" text="Đối tượng" prefWidth="150"/>
                    <TableColumn fx:id="colDescription" text="Mô tả" prefWidth="360"/>
                    <TableColumn fx:id="colCreatedAt" text="Thời gian" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>
