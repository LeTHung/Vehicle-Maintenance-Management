<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.user.UserController"
      spacing="18"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Quản lý người dùng" styleClass="page-title"/>
        <Label text="Tạo, cập nhật, khóa và mở khóa tài khoản đăng nhập hệ thống." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" styleClass="toolbar-panel">
        <Button fx:id="addButton" text="+ Thêm người dùng" onAction="#onAddClick" styleClass="btn-primary"/>
        <Button fx:id="editButton" text="Sửa" onAction="#onEditClick" styleClass="btn-soft"/>
        <Button fx:id="lockButton" text="Khóa/Mở" onAction="#onLockClick" styleClass="btn-ghost"/>
        <Button fx:id="refreshButton" text="Làm mới" onAction="#onRefreshClick" styleClass="btn-soft"/>
    </HBox>

    <VBox styleClass="table-panel" VBox.vgrow="ALWAYS">
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colUserId" text="ID" prefWidth="70"/>
                <TableColumn fx:id="colUsername" text="Username" prefWidth="140"/>
                <TableColumn fx:id="colFullName" text="Họ tên" prefWidth="190"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="210"/>
                <TableColumn fx:id="colPhone" text="Điện thoại" prefWidth="130"/>
                <TableColumn fx:id="colRole" text="Vai trò" prefWidth="170"/>
                <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120"/>
                <TableColumn fx:id="colLastLogin" text="Đăng nhập gần nhất" prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
