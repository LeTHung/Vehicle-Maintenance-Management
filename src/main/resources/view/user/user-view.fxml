<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.user.UserController"
      spacing="18"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Quan ly nguoi dung" styleClass="page-title"/>
        <Label text="Tao, cap nhat, khoa va mo khoa tai khoan dang nhap he thong." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" styleClass="toolbar">
        <Button fx:id="addButton" text="Them" onAction="#onAddClick" styleClass="primary-button"/>
        <Button fx:id="editButton" text="Sua" onAction="#onEditClick" styleClass="secondary-button"/>
        <Button fx:id="lockButton" text="Khoa/Mo" onAction="#onLockClick" styleClass="secondary-button"/>
        <Button fx:id="refreshButton" text="Lam moi" onAction="#onRefreshClick" styleClass="secondary-button"/>
    </HBox>

    <TableView fx:id="userTable" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colUserId" text="ID" prefWidth="70"/>
            <TableColumn fx:id="colUsername" text="Username" prefWidth="140"/>
            <TableColumn fx:id="colFullName" text="Ho ten" prefWidth="190"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="210"/>
            <TableColumn fx:id="colPhone" text="Dien thoai" prefWidth="130"/>
            <TableColumn fx:id="colRole" text="Vai tro" prefWidth="170"/>
            <TableColumn fx:id="colStatus" text="Trang thai" prefWidth="120"/>
            <TableColumn fx:id="colLastLogin" text="Dang nhap gan nhat" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>
