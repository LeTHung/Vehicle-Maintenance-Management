<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.VehicleController"
      stylesheets="@../css/pages/vehicle.css"
      spacing="18"
      styleClass="page">

    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <VBox spacing="4">
        <Label text="Quản lý phương tiện" styleClass="page-title"/>
        <Label text="Quản lý mã xe, biển số, loại xe, hãng xe, ODO và trạng thái phương tiện." styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="12" styleClass="toolbar">
        <TextField fx:id="txtSearch" promptText="Tìm theo mã xe, biển số, hãng xe..." HBox.hgrow="ALWAYS" styleClass="input-field"/>
        <Button text="Tìm kiếm" onAction="#handleSearchVehicle" styleClass="secondary-button"/>
        <Button text="Làm mới" onAction="#handleRefreshVehicle" styleClass="secondary-button"/>
    </HBox>

    <GridPane hgap="12" vgap="12" styleClass="form-card">
        <columnConstraints>
            <ColumnConstraints percentWidth="14"/>
            <ColumnConstraints percentWidth="19"/>
            <ColumnConstraints percentWidth="14"/>
            <ColumnConstraints percentWidth="19"/>
            <ColumnConstraints percentWidth="14"/>
            <ColumnConstraints percentWidth="20"/>
        </columnConstraints>

        <Label text="Mã xe" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="txtVehicleCode" promptText="VD: VH001" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="input-field"/>

        <Label text="Biển số" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="form-label"/>
        <TextField fx:id="txtLicensePlate" promptText="VD: 51A-12345" GridPane.rowIndex="0" GridPane.columnIndex="3" styleClass="input-field"/>

        <Label text="Loại xe" GridPane.rowIndex="0" GridPane.columnIndex="4" styleClass="form-label"/>
        <ComboBox fx:id="cbVehicleType" promptText="Chọn loại xe" GridPane.rowIndex="0" GridPane.columnIndex="5" maxWidth="Infinity" styleClass="input-field"/>

        <Label text="Hãng xe" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="txtBrand" promptText="VD: Hyundai" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="input-field"/>

        <Label text="Dòng xe" GridPane.rowIndex="1" GridPane.columnIndex="2" styleClass="form-label"/>
        <TextField fx:id="txtModel" promptText="VD: Mighty" GridPane.rowIndex="1" GridPane.columnIndex="3" styleClass="input-field"/>

        <Label text="Màu xe" GridPane.rowIndex="1" GridPane.columnIndex="4" styleClass="form-label"/>
        <TextField fx:id="txtColor" promptText="VD: Trắng" GridPane.rowIndex="1" GridPane.columnIndex="5" styleClass="input-field"/>

        <Label text="Năm sản xuất" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="txtManufactureYear" promptText="VD: 2020" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="input-field"/>

        <Label text="Ngày mua" GridPane.rowIndex="2" GridPane.columnIndex="2" styleClass="form-label"/>
        <DatePicker fx:id="dpPurchaseDate" GridPane.rowIndex="2" GridPane.columnIndex="3" maxWidth="Infinity" styleClass="input-field"/>

        <Label text="ODO hiện tại" GridPane.rowIndex="2" GridPane.columnIndex="4" styleClass="form-label"/>
        <TextField fx:id="txtCurrentOdometer" promptText="VD: 35000" GridPane.rowIndex="2" GridPane.columnIndex="5" styleClass="input-field"/>

        <Label text="Số khung" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="txtChassisNumber" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="input-field"/>

        <Label text="Số máy" GridPane.rowIndex="3" GridPane.columnIndex="2" styleClass="form-label"/>
        <TextField fx:id="txtEngineNumber" GridPane.rowIndex="3" GridPane.columnIndex="3" styleClass="input-field"/>

        <Label text="Trạng thái" GridPane.rowIndex="3" GridPane.columnIndex="4" styleClass="form-label"/>
        <ComboBox fx:id="cbVehicleStatus" promptText="Chọn trạng thái" GridPane.rowIndex="3" GridPane.columnIndex="5" maxWidth="Infinity" styleClass="input-field"/>

        <Label text="Ghi chú" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="form-label"/>
        <TextField fx:id="txtNotes" promptText="Ghi chú thêm nếu có" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="5" styleClass="input-field"/>

        <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="6">
            <Button text="Lưu" onAction="#handleSaveVehicle" styleClass="primary-button"/>
            <Button text="Cập nhật" onAction="#handleUpdateVehicle" styleClass="secondary-button"/>
            <Button text="Xóa trắng" onAction="#handleClearVehicleForm" styleClass="secondary-button"/>
        </HBox>
    </GridPane>

    <TableView fx:id="tblVehicle" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columns>
            <TableColumn fx:id="colVehicleId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colVehicleCode" text="Mã xe" prefWidth="100"/>
            <TableColumn fx:id="colLicensePlate" text="Biển số" prefWidth="130"/>
            <TableColumn fx:id="colVehicleType" text="Loại xe" prefWidth="130"/>
            <TableColumn fx:id="colBrand" text="Hãng" prefWidth="120"/>
            <TableColumn fx:id="colModel" text="Dòng xe" prefWidth="120"/>
            <TableColumn fx:id="colManufactureYear" text="Năm SX" prefWidth="90"/>
            <TableColumn fx:id="colPurchaseDate" text="Ngày mua" prefWidth="120"/>
            <TableColumn fx:id="colChassisNumber" text="Số khung" prefWidth="150"/>
            <TableColumn fx:id="colEngineNumber" text="Số máy" prefWidth="150"/>
            <TableColumn fx:id="colColor" text="Màu" prefWidth="90"/>
            <TableColumn fx:id="colCurrentOdometer" text="ODO" prefWidth="100"/>
            <TableColumn fx:id="colVehicleStatus" text="Trạng thái" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
