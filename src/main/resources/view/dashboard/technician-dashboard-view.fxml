<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.dashboard.TechnicianDashboardController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="28" styleClass="page">
        <VBox styleClass="hero-tech">
            <Label text="Technician Maintenance Dashboard" styleClass="display-title"/>
            <Label text="Theo dõi lịch bảo dưỡng, phiếu sửa chữa, vật tư và lịch sử kỹ thuật của từng phương tiện." styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button text="+ Tạo phiếu bảo dưỡng" onAction="#handleOpenMaintenanceRecord" styleClass="btn-primary"/>
                <Button text="Xem lịch hôm nay" onAction="#handleOpenMaintenanceAlert" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
        <HBox spacing="18">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="Lệnh chờ xử lý" styleClass="metric-label"/><Label text="12" styleClass="metric-value"/><Label text="5 mức ưu tiên cao" styleClass="metric-trend-warning"/></VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="Đang sửa chữa" styleClass="metric-label"/><Label text="7" styleClass="metric-value-warning"/><Label text="Theo dõi trong xưởng" styleClass="metric-trend-primary"/></VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="Hoàn tất hôm nay" styleClass="metric-label"/><Label text="4" styleClass="metric-value"/><Label text="Cần cập nhật ODO" styleClass="metric-trend-success"/></VBox>
        </HBox>
        <VBox spacing="14" styleClass="panel">
            <Label text="Công việc kỹ thuật" styleClass="section-title"/>
            <HBox spacing="14">
                <VBox spacing="10" styleClass="module-card" HBox.hgrow="ALWAYS">
                    <Label text="Kế hoạch bảo dưỡng" styleClass="item-title"/>
                    <Label text="Xe đến hạn theo ngày hoặc số km." styleClass="item-subtitle"/>
                    <Button text="Xem xe đến hạn" onAction="#handleOpenMaintenanceAlert" styleClass="btn-soft"/>
                </VBox>
                <VBox spacing="10" styleClass="module-card" HBox.hgrow="ALWAYS">
                    <Label text="Cập nhật bảo dưỡng" styleClass="item-title"/>
                    <Label text="Nhập nội dung sửa chữa, chi phí, phụ tùng." styleClass="item-subtitle"/>
                    <Button text="Mở phiếu bảo dưỡng" onAction="#handleOpenMaintenanceRecord" styleClass="btn-soft"/>
                </VBox>
                <VBox spacing="10" styleClass="module-card" HBox.hgrow="ALWAYS">
                    <Label text="Lịch sử phương tiện" styleClass="item-title"/>
                    <Label text="Tra cứu hồ sơ sửa chữa theo xe." styleClass="item-subtitle"/>
                    <Button text="Tra cứu phiếu" onAction="#handleOpenMaintenanceRecord" styleClass="btn-soft"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
