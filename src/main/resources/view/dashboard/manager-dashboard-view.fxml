<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.dashboard.ManagerDashboardController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="22" styleClass="page">
        <VBox fx:id="spotlight" styleClass="spotlight">
            <Label text="CẦN CHÚ Ý" styleClass="spotlight-eyebrow"/>
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label fx:id="lblSpotlightTitle" text="Mọi thứ đang trong tầm kiểm soát"
                           styleClass="spotlight-title" wrapText="true"/>
                    <Label fx:id="lblSpotlightText"
                           text="Hiện chưa có giấy tờ hoặc xe bảo dưỡng nào quá hạn."
                           styleClass="spotlight-text" wrapText="true"/>
                </VBox>
                <Button fx:id="btnSpotlight" text="Xem chi tiết" onAction="#handleSpotlightAction"
                        styleClass="btn-primary"/>
            </HBox>
        </VBox>

        <HBox spacing="14">
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Tổng phương tiện" styleClass="kpi-label"/>
                <Label fx:id="lblTotalVehicles" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Đang hoạt động" styleClass="kpi-label"/>
                <Label fx:id="lblActiveVehicles" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Giấy tờ sắp hạn" styleClass="kpi-label"/>
                <Label fx:id="lblComingDueDocuments" text="0" styleClass="kpi-value-warning"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Xe sắp bảo dưỡng" styleClass="kpi-label"/>
                <Label fx:id="lblMaintenanceComingDue" text="0" styleClass="kpi-value-warning"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Phiếu đang xử lý" styleClass="kpi-label"/>
                <Label fx:id="lblOpenRecords" text="0" styleClass="kpi-value"/>
            </VBox>
            <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                <Label text="Chi phí BD năm nay" styleClass="kpi-label"/>
                <Label fx:id="lblMaintenanceCostYear" text="0" styleClass="kpi-value"/>
            </VBox>
        </HBox>

        <VBox spacing="16" styleClass="panel">
            <HBox spacing="12" styleClass="table-title-row">
                <VBox spacing="2">
                    <Label text="Việc cần xử lý" styleClass="section-title"/>
                    <Label text="Giấy tờ và xe bảo dưỡng đang đến hạn, sắp xếp theo mức ưu tiên."
                           styleClass="item-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Giấy tờ" onAction="#handleOpenDocumentAlert" styleClass="btn-soft"/>
                <Button text="Bảo dưỡng" onAction="#handleOpenMaintenanceAlert" styleClass="btn-soft"/>
            </HBox>
            <VBox fx:id="unifiedAlertList" spacing="10"/>
        </VBox>
    </VBox>
</ScrollPane>
