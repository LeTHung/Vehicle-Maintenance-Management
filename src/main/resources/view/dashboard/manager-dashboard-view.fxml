<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml" fitToWidth="true" styleClass="page-scroll">
    <VBox spacing="28" styleClass="page">
        <VBox styleClass="hero-manager">
            <Label text="Fleet Operations Dashboard" styleClass="display-title"/>
            <Label text="Trung tâm điều phối đội xe: phương tiện, giấy tờ pháp lý, bảo dưỡng và chi phí." styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button text="+ Thêm xe mới" styleClass="btn-primary"/>
                <Button text="Xuất báo cáo" styleClass="btn-ghost"/>
            </HBox>
        </VBox>

        <HBox spacing="18">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Tổng phương tiện" styleClass="metric-label"/>
                <Label text="128" styleClass="metric-value"/>
                <Label text="+8 xe trong tháng" styleClass="metric-trend-success"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Đang hoạt động" styleClass="metric-label"/>
                <Label text="112" styleClass="metric-value"/>
                <Label text="87.5% đội xe" styleClass="metric-trend-primary"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Giấy tờ sắp hạn" styleClass="metric-label"/>
                <Label text="14" styleClass="metric-value-warning"/>
                <Label text="Cần xử lý 15 ngày tới" styleClass="metric-trend-warning"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Xe cần bảo dưỡng" styleClass="metric-label"/>
                <Label text="9" styleClass="metric-value-danger"/>
                <Label text="Ưu tiên kỹ thuật" styleClass="metric-trend-danger"/>
            </VBox>
        </HBox>

        <HBox spacing="22">
            <VBox spacing="16" styleClass="panel" HBox.hgrow="ALWAYS">
                <Label text="Hoạt động đội xe" styleClass="section-title"/>
                <HBox spacing="12" styleClass="timeline-row">
                    <Label text="●" styleClass="dot-success"/>
                    <VBox>
                        <Label text="51A-12345 hoàn tất cập nhật ODO" styleClass="item-title"/>
                        <Label text="Cập nhật 35.000 km, trạng thái ACTIVE" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" styleClass="timeline-row">
                    <Label text="●" styleClass="dot-warning"/>
                    <VBox>
                        <Label text="51B-67890 có phí đường bộ hết hạn" styleClass="item-title"/>
                        <Label text="Cần cập nhật giấy tờ trước khi vận hành" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
                <HBox spacing="12" styleClass="timeline-row">
                    <Label text="●" styleClass="dot-primary"/>
                    <VBox>
                        <Label text="51C-24680 đang trong trạng thái bảo dưỡng" styleClass="item-title"/>
                        <Label text="Chờ xác nhận từ bộ phận kỹ thuật" styleClass="item-subtitle"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="16" styleClass="panel" prefWidth="360">
                <Label text="Ưu tiên hôm nay" styleClass="section-title"/>
                <VBox styleClass="priority-card-warning">
                    <Label text="Giấy tờ sắp hết hạn" styleClass="priority-title"/>
                    <Label text="Kiểm tra đăng kiểm, bảo hiểm, phí đường bộ của các xe cảnh báo." styleClass="priority-text"/>
                </VBox>
                <VBox styleClass="priority-card-primary">
                    <Label text="Chuẩn hóa hồ sơ xe" styleClass="priority-title"/>
                    <Label text="Bổ sung mã xe, số khung, số máy, hãng xe và dòng xe để nối bảo dưỡng." styleClass="priority-text"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
