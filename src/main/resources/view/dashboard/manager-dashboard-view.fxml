<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.dashboard.ManagerDashboardController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="28" styleClass="page">
        <VBox styleClass="hero-manager">
            <Label text="Fleet Operations Dashboard" styleClass="display-title"/>
            <Label text="Trung tâm điều phối đội xe: phương tiện, giấy tờ pháp lý, bảo dưỡng và chi phí." styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button text="+ Thêm xe mới" styleClass="btn-primary"/>
                <Button text="Xuất báo cáo" styleClass="btn-ghost"/>
            </HBox>
        </VBox>

        <HBox spacing="18">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Tổng phương tiện" styleClass="metric-label"/>
                <Label fx:id="lblTotalVehicles" text="0" styleClass="metric-value"/>
                <Label text="Dữ liệu từ bảng vehicles" styleClass="metric-trend-primary"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Đang hoạt động" styleClass="metric-label"/>
                <Label fx:id="lblActiveVehicles" text="0" styleClass="metric-value"/>
                <Label text="Trạng thái ACTIVE" styleClass="metric-trend-success"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Giấy tờ sắp hạn" styleClass="metric-label"/>
                <Label fx:id="lblComingDueDocuments" text="0" styleClass="metric-value-warning"/>
                <Label text="Cần xử lý 15 ngày tới" styleClass="metric-trend-warning"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Giấy tờ quá hạn" styleClass="metric-label"/>
                <Label fx:id="lblOverdueDocuments" text="0" styleClass="metric-value-danger"/>
                <Label text="Ưu tiên xử lý" styleClass="metric-trend-danger"/>
            </VBox>
        </HBox>

        <HBox spacing="22">
            <VBox spacing="16" styleClass="panel" HBox.hgrow="ALWAYS">
                <Label text="Cảnh báo giấy tờ ưu tiên" styleClass="section-title"/>
                <VBox fx:id="alertList" spacing="12"/>
            </VBox>

            <VBox spacing="16" styleClass="panel" prefWidth="360">
                <Label text="Ưu tiên hôm nay" styleClass="section-title"/>
                <VBox styleClass="priority-card-warning">
                    <Label text="Giấy tờ cần theo dõi" styleClass="priority-title"/>
                    <Label fx:id="lblPriorityText"
                           text="Theo dõi giấy tờ sắp hết hạn trong 15 ngày tới."
                           wrapText="true"
                           styleClass="priority-text"/>
                </VBox>
                <VBox styleClass="priority-card-primary">
                    <Label text="Chuẩn hóa hồ sơ xe" styleClass="priority-title"/>
                    <Label text="Bổ sung mã xe, số khung, số máy, hãng xe và dòng xe để nối bảo dưỡng."
                           wrapText="true"
                           styleClass="priority-text"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
