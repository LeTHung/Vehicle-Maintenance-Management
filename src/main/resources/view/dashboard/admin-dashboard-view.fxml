<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.dashboard.AdminDashboardController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="28" styleClass="page">
        <VBox styleClass="hero-admin">
            <Label text="Bảng điều khiển quản trị hệ thống" styleClass="display-title"/>
            <Label text="Quản lý người dùng, vai trò, phân quyền và cấu hình hệ thống FleetCare." styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button text="+ Tạo người dùng" onAction="#handleOpenUserManagement" styleClass="btn-primary"/>
                <Button text="Cấu hình quyền" onAction="#handleOpenRoleManagement" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
        <HBox spacing="18">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Người dùng" styleClass="metric-label"/>
                <Label fx:id="lblTotalUsers" text="0" styleClass="metric-value"/>
                <Label fx:id="lblUserHint" text="0 vai trò hoạt động" styleClass="metric-trend-primary"/>
            </VBox>

            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Tài khoản khóa" styleClass="metric-label"/>
                <Label fx:id="lblLockedUsers" text="0" styleClass="metric-value-warning"/>
                <Label fx:id="lblLockedHint" text="Dữ liệu từ trạng thái tài khoản" styleClass="metric-trend-warning"/>
            </VBox>

            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Cảnh báo nghiệp vụ" styleClass="metric-label"/>
                <Label fx:id="lblSystemAlerts" text="0" styleClass="metric-value-danger"/>
                <Label fx:id="lblAlertHint" text="Giấy tờ + bảo dưỡng" styleClass="metric-trend-danger"/>
            </VBox>
        </HBox>
        <VBox spacing="14" styleClass="panel">
            <Label text="Phân hệ quản trị" styleClass="section-title"/>
            <HBox spacing="14">
                <VBox styleClass="module-card" HBox.hgrow="ALWAYS"><Label text="Quản lý người dùng" styleClass="item-title"/><Label text="Tạo, sửa, khóa/mở khóa tài khoản." styleClass="item-subtitle"/></VBox>
                <VBox styleClass="module-card" HBox.hgrow="ALWAYS"><Label text="Vai trò &amp; phân quyền" styleClass="item-title"/><Label text="Ẩn/hiện menu theo quyền đăng nhập." styleClass="item-subtitle"/></VBox>
                <VBox styleClass="module-card" HBox.hgrow="ALWAYS"><Label text="Dữ liệu nghiệp vụ" styleClass="item-title"/><Label fx:id="lblVehicleCount" text="0 phương tiện" styleClass="item-subtitle"/><Label fx:id="lblDocumentAlertCount" text="0 cảnh báo giấy tờ" styleClass="item-subtitle"/></VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
