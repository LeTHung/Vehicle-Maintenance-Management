<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.dashboard.AdminDashboardController"
            fitToWidth="true"
            styleClass="page-scroll">
    <VBox spacing="28" styleClass="page">
        <VBox styleClass="hero-admin">
            <Label text="Dashboard quản trị hệ thống" styleClass="display-title"/>
            <Label text="Quản lý người dùng, nhật ký hoạt động và trạng thái vận hành FleetCare." styleClass="hero-subtitle"/>
            <HBox spacing="12">
                <Button text="+ Tạo người dùng" onAction="#handleCreateUser" styleClass="btn-primary"/>
                <Button text="Xem nhật ký hoạt động" onAction="#handleOpenAuditLog" styleClass="btn-ghost"/>
            </HBox>
        </VBox>
        <HBox spacing="18">
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Tổng tài khoản" styleClass="metric-label"/>
                <Label fx:id="lblTotalUsers" text="0" styleClass="metric-value"/>
                <Label fx:id="lblTotalUsersHint" text="Tài khoản đã tạo" styleClass="metric-trend-primary"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Tài khoản bị khóa" styleClass="metric-label"/>
                <Label fx:id="lblLockedUsers" text="0" styleClass="metric-value-warning"/>
                <Label fx:id="lblLockedUsersHint" text="Đang ổn định" styleClass="metric-trend-warning"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Vai trò hoạt động" styleClass="metric-label"/>
                <Label fx:id="lblActiveRoles" text="0" styleClass="metric-value"/>
                <Label fx:id="lblActiveRolesHint" text="Vai trò đang hoạt động" styleClass="metric-trend-primary"/>
            </VBox>
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                <Label text="Nhật ký hôm nay" styleClass="metric-label"/>
                <Label fx:id="lblRecentAuditLogs" text="0" styleClass="metric-value-danger"/>
                <Label fx:id="lblRecentAuditLogsHint" text="Hoạt động trong hôm nay" styleClass="metric-trend-danger"/>
            </VBox>
        </HBox>
        <VBox spacing="14" styleClass="panel">
            <Label text="Module quản trị" styleClass="section-title"/>
            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" onMouseClicked="#handleOpenUsers">
                    <styleClass>
                        <String fx:value="module-card"/>
                        <String fx:value="clickable-card"/>
                    </styleClass>
                    <Label text="Quản lý người dùng" styleClass="item-title"/>
                    <Label text="Tạo, sửa, khóa/mở khóa tài khoản." styleClass="item-subtitle"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" onMouseClicked="#handleOpenAuditLog">
                    <styleClass>
                        <String fx:value="module-card"/>
                        <String fx:value="clickable-card"/>
                    </styleClass>
                    <Label text="Nhật ký hoạt động" styleClass="item-title"/>
                    <Label text="Theo dõi thao tác quan trọng của hệ thống." styleClass="item-subtitle"/>
                </VBox>
                <VBox styleClass="module-card" HBox.hgrow="ALWAYS"><Label text="Trạng thái hệ thống" styleClass="item-title"/><Label text="Rà soát tài khoản khóa và dữ liệu vận hành." styleClass="item-subtitle"/></VBox>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
